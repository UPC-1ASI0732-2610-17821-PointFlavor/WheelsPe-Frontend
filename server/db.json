  "reviews": [
    { "id": 1,  "huariqueId": 1,  "author": "Camila R.", "initials": "CR", "rating": 5, "when": "hace 3 días",   "text": "El cuarto de pollo con papas fritas es la versión más limpia que he probado. La crema de ajo es adictiva. Tres generaciones se nota.", "tags": ["Familiar","Vale la espera"], "status": "approved" },
    { "id": 2,  "huariqueId": 1,  "author": "Andrés Q.", "initials": "AQ", "rating": 4, "when": "hace 1 semana", "text": "Buen pollo, atención correcta. La salsa de huacatay le da carácter.",                                                                "tags": ["Servicio"],                  "status": "approved" },
    { "id": 3,  "huariqueId": 1,  "author": "Marina P.", "initials": "MP", "rating": 5, "when": "hace 2 semanas","text": "Vine después de años y el sabor sigue intacto. Eso ya es noticia.",                                                                  "tags": ["Tradicional"],               "status": "approved" },
    { "id": 4,  "huariqueId": 5,  "author": "Sofía L.",  "initials": "SL", "rating": 5, "when": "hace 5 días",   "text": "Pedí tres tipos de ceviche y todos llegaron perfectos. La leche de tigre es de otro nivel. Vista al mar de regalo.",               "tags": ["Vista al mar","Fresco"],     "status": "approved" },
    { "id": 5,  "huariqueId": 5,  "author": "Renato M.", "initials": "RM", "rating": 5, "when": "hace 1 semana", "text": "Pisco sour delicado, no muy dulce. La causa de cangrejo vale cada sol.",                                                            "tags": ["Pisco"],                     "status": "approved" },
    { "id": 6,  "huariqueId": 8,  "author": "Diego F.",  "initials": "DF", "rating": 4, "when": "hace 4 días",   "text": "Picantería de verdad. El rocoto relleno te despierta los sentidos.",                                                                "tags": ["Tradicional"],               "status": "approved" },
    { "id": 7,  "huariqueId": 9,  "author": "Ana T.",    "initials": "AT", "rating": 5, "when": "hace 1 semana", "text": "El kam lu wantán es de otra época. Cantonés bien hecho.",                                                                           "tags": ["Tradicional"],               "status": "approved" },
    { "id": 8,  "huariqueId": 12, "author": "Lucía V.",  "initials": "LV", "rating": 5, "when": "hace 2 días",   "text": "Los milhojas se deshacen al morder. Cafetería de domingo.",                                                                         "tags": ["Café"],                      "status": "approved" }
